# Copy this file to .env before running `docker compose up`.

# Any password — MariaDB creates this user/database on first boot.
DB_PASSWORD=change-me
# MariaDB's root password — only needed for admin access, not by the app.
DB_ROOT_PASSWORD=change-me-too

# Signs the login session cookie. Generate one with, e.g.:
#   openssl rand -base64 32
COOKIE_SECRET=change-me-to-a-long-random-string

# Optional: enables the "Continue with Google" button. Leave both unset to
# keep email/password as the only login method (self-hosted default).
#
# Create these at https://console.cloud.google.com/apis/credentials
# ("Create credentials" -> "OAuth client ID" -> "Web application"), with an
# authorized redirect URI of exactly:
#   https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The origin this app is reachable at from the outside — must match the
# redirect URI registered above.
APP_ORIGIN=https://familyseed.villamarmot.duckdns.org
