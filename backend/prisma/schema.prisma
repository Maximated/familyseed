generator client {
  provider      = "prisma-client-js"
  // "native" alone isn't reliable across a Docker multi-stage build: the
  // backend-build stage (where `prisma generate` runs) and the runtime
  // stage are both node:22-slim, but the runtime stage's extra apt
  // packages (Chromium and its dependencies) pull in a newer OpenSSL than
  // what's on the plain build stage, so the engine binary "native"
  // detects at generate time doesn't match what's actually there when the
  // app starts. Listing both OpenSSL variants for each architecture the
  // image gets built on covers that mismatch; linux-arm64 covers building
  // locally on Apple Silicon (this repo's dev machine), debian covers the
  // x86_64 GitHub Actions runner that publishes the real ghcr.io image.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

// Precision of a genealogical date, since exact dates are the exception,
// not the rule (parish records, oral history, estimates from other events...).
enum DatePrecision {
  EXACT
  ABOUT
  BEFORE
  AFTER
  UNKNOWN
}

enum UnionType {
  MARRIAGE
  PARTNERSHIP
  EXTRAMARITAL
  UNKNOWN
}

// The union's current/final state — a separate axis from UnionType (which
// describes its nature, not how or whether it ended). Drives the divorce/
// widowed icons on the tree.
enum UnionStatus {
  ONGOING
  ENDED_BY_DEATH
  DIVORCED
  SEPARATED
  ANNULLED
}

enum ChildRelationType {
  BIOLOGICAL
  ADOPTED
  FOSTER
  STEP
  UNKNOWN
}

// Role a user holds *within a specific tree* — permissions are scoped to
// the tree, not to individual people or fields. A user can hold different
// roles on different trees (e.g. owner of their own, viewer on an
// in-law's).
enum TreeRole {
  OWNER
  EDITOR
  VIEWER
}

// A person using the app. Self-hosted deployments can get by with a
// single row created by the seed and no real login; the hosted mode
// (Google OAuth via Auth.js/Lucia, added later) fills `googleId` instead.
// Both modes use the exact same schema/rows — only how a User row gets
// created and how a request resolves "the current user" differs.
model User {
  id        String  @id @default(cuid())
  email     String? @unique
  name      String?
  googleId  String? @unique @map("google_id")
  avatarUrl String? @map("avatar_url")

  // Set on registration for local email/password accounts; stays null for
  // accounts that only ever sign in via `googleId` once hosted-mode OAuth
  // exists.
  passwordHash String? @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at")

  memberships           TreeMember[]
  changes               ChangeLogEntry[]
  sessions              Session[]
  createdInviteLinks    TreeInviteLink[]
  inviteLinkRedemptions TreeInviteLinkRedemption[]
  treeIdentities        UserTreeIdentity[]

  @@map("users")
}

// The session cookie holds this row's id (signed), not the userId directly
// — the previous scheme signed the raw userId, which meant "log out"
// could only ever clear the cookie client-side: the same signed value
// would keep authenticating forever (up to its 30-day maxAge) if it had
// already been copied elsewhere. Looking a session up here on every
// request means logout — or revoking a specific device — actually ends
// it, immediately, everywhere that cookie is used.
model Session {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

// A family tree. Every genealogical entity (Individual, Family, Lineage)
// belongs to exactly one tree — v1 only ever creates one via the seed, but
// scoping by tree_id from day one means adding multi-tree/multi-user
// support later is additive, not a rewrite. `name` is the user-editable
// tree title shown in the app header.
model Tree {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members     TreeMember[]
  individuals Individual[]
  families    Family[]
  lineages    Lineage[]
  changes     ChangeLogEntry[]
  media       PersonMedia[]
  inviteLinks TreeInviteLink[]
  identities  UserTreeIdentity[]

  @@map("trees")
}

// Membership + role of a user within a tree — the whole permission model:
// owner (full control incl. members), editor (add/edit people & rels),
// viewer (read-only). Not yet enforced by the API (no auth exists yet),
// but the shape is in place so enforcing it later doesn't need a
// migration.
model TreeMember {
  id String @id @default(cuid())

  treeId String @map("tree_id")
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role TreeRole @default(VIEWER)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([treeId, userId])
  @@index([userId])
  @@map("tree_members")
}

// A user's personal "this is me" pin within a specific tree — deliberately
// separate from TreeMember: marking yourself is a personal preference any
// role (including VIEWER) can set, not an edit permission. At most one row
// per user per tree; individualId is intentionally not unique on its own,
// since two different users may each point at the same person (e.g. by
// mistake, or a shared account scenario) without conflict.
model UserTreeIdentity {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  treeId String @map("tree_id")
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  individualId String     @map("individual_id")
  individual   Individual @relation(fields: [individualId], references: [id], onDelete: Cascade)

  createdAt DateTime @updatedAt @map("created_at")

  @@unique([userId, treeId])
  @@index([treeId])
  @@index([individualId])
  @@map("user_tree_identities")
}

// A shareable join-by-URL link for a tree, generated by the owner — an
// alternative to members.ts's "add by email" flow for someone who doesn't
// have an account yet. The link's own id is the unguessable part of the
// URL (consistent with how every other id in this schema already works in
// exposed URLs, e.g. treeId itself) rather than a separate token field.
// Redeeming one always requires being logged in first (see
// invite-redeem.ts) — it only ever produces a normal TreeMember row, no
// parallel anonymous-access path.
model TreeInviteLink {
  id String @id @default(cuid())

  treeId String @map("tree_id")
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  role TreeRole @default(VIEWER)

  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  // null = unlimited — a link shared once in a family group chat for
  // several relatives to join is the expected case, not the exception.
  maxUses   Int?      @map("max_uses")

  redemptions TreeInviteLinkRedemption[]

  @@index([treeId])
  @@map("tree_invite_links")
}

// One row per user who has ever redeemed a given link — the unique
// constraint makes a repeat redemption by the same user a no-op rather
// than a second row, and as a side effect gives the owner free visibility
// into who actually joined via which link.
model TreeInviteLinkRedemption {
  id String @id @default(cuid())

  inviteLinkId String         @map("invite_link_id")
  inviteLink   TreeInviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([inviteLinkId, userId])
  @@index([userId])
  @@map("tree_invite_link_redemptions")
}

// Minimal audit trail — who changed what and when — kept as a flat,
// append-only log rather than per-field diffs, since "simple" was the
// point: enough to answer "who touched this" without modeling every
// entity's change shape up front.
model ChangeLogEntry {
  id String @id @default(cuid())

  treeId String @map("tree_id")
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // e.g. "individual.create", "individual.update", "family.delete"
  action String

  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  summary String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([treeId, createdAt])
  @@map("change_log_entries")
}

model Individual {
  id String @id @default(cuid())

  treeId String @map("tree_id")
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  givenNames String @map("given_names")

  // Primary/lineage-grouping surname: paternal surname in Spanish naming,
  // the only surname in Polish naming. Current/used, not necessarily the
  // one this person was born with (see surname1BirthName below).
  surname1 String @map("apellido_1")

  // Secondary surname (Spanish maternal surname convention). Null for
  // single-surname naming conventions (e.g. Polish).
  surname2 String? @map("apellido_2")

  // surname1 at birth, only set when it differs from the current surname1.
  // Deliberately not tied to sex: in most cases the wife takes the
  // husband's surname, but the reverse also happens (and is recorded this
  // way in this family), so this field is symmetric and applies to
  // whichever partner changed their name. Surname2 is a Spanish-convention
  // maternal surname that doesn't change at marriage, so it needs no
  // birth-name counterpart.
  surname1BirthName String? @map("apellido_1_nacimiento")

  // Nickname/alias this person went by — distinct from surname1BirthName
  // (which is still a legal surname, just an earlier one). Shown in
  // cursive on the tree card to set it apart from the real name.
  alias String?

  sex Sex @default(UNKNOWN)

  birthDateText      String?        @map("birth_date_text")
  birthDateValue     DateTime?      @map("birth_date_value")
  birthDatePrecision DatePrecision? @map("birth_date_precision")
  birthPlace         String?        @map("birth_place")

  deathDateText      String?        @map("death_date_text")
  deathDateValue     DateTime?      @map("death_date_value")
  deathDatePrecision DatePrecision? @map("death_date_precision")
  deathPlace         String?        @map("death_place")

  notes     String? @db.Text
  biography String? @map("biography") @db.Text
  photoUrl  String? @map("photo_url")

  // Original ID from a GEDCOM import, kept for round-tripping export/import.
  // Unique per tree, not globally — two independently imported trees can
  // (and often do) reuse the same GEDCOM "@I1@"-style xrefs.
  gedcomXref String? @map("gedcom_xref")

  // Set when this row was created by "copy person"/"copy lineage" between
  // trees — points at the individual it was copied from (in whatever tree
  // that was). Nothing reads this for matching/deduplication yet; it's
  // provenance for a future "detect duplicates across trees" pass.
  // SetNull on delete: losing the original shouldn't cascade-delete the copy.
  originIndividualId String?      @map("origin_individual_id")
  originIndividual   Individual?  @relation("IndividualOrigin", fields: [originIndividualId], references: [id], onDelete: SetNull)
  copiedAs           Individual[] @relation("IndividualOrigin")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  familiesAsPartner1 Family[]            @relation("FamilyPartner1")
  familiesAsPartner2 Family[]            @relation("FamilyPartner2")
  childOf            FamilyChild[]
  lineages           IndividualLineage[]
  media              PersonMedia[]
  identities         UserTreeIdentity[]

  @@unique([treeId, gedcomXref])
  @@index([treeId, surname1, givenNames])
  @@index([originIndividualId])
  @@map("individuals")
}

// Purely a navigation/highlighting aid (see the sidebar timeline + lineage
// filter chips planned for the frontend) — not part of the genealogical
// relationships themselves, which live entirely in Family/FamilyChild.
// Membership is manual: an individual can belong to several lineages at
// once (their father's, their mother's, their spouse's...), it's not
// auto-derived from surname1.
model Lineage {
  id String @id @default(cuid())

  treeId String @map("tree_id")
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  name String

  // Hex or CSS color for the filter chip / highlighted branch in the UI.
  color String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  individuals IndividualLineage[]

  @@index([treeId])
  @@map("lineages")
}

model IndividualLineage {
  id String @id @default(cuid())

  individualId String     @map("individual_id")
  individual   Individual @relation(fields: [individualId], references: [id], onDelete: Cascade)

  lineageId String  @map("lineage_id")
  lineage   Lineage @relation(fields: [lineageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([individualId, lineageId])
  @@index([lineageId])
  @@map("individual_lineages")
}

model Family {
  id String @id @default(cuid())

  treeId String @map("tree_id")
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  partner1Id String?     @map("partner1_id")
  partner1   Individual? @relation("FamilyPartner1", fields: [partner1Id], references: [id])

  partner2Id String?     @map("partner2_id")
  partner2   Individual? @relation("FamilyPartner2", fields: [partner2Id], references: [id])

  unionType   UnionType   @default(UNKNOWN) @map("union_type")
  unionStatus UnionStatus @default(ONGOING) @map("union_status")

  unionDateText      String?        @map("union_date_text")
  unionDateValue     DateTime?      @map("union_date_value")
  unionDatePrecision DatePrecision? @map("union_date_precision")
  unionPlace         String?        @map("union_place")

  // Free-text annotation on this union/"event" — the same kind of note an
  // Individual can carry, just scoped to the marriage/partnership itself
  // rather than one person.
  notes String? @db.Text

  // Unique per tree, not globally — see the same note on Individual.
  gedcomXref String? @map("gedcom_xref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  children FamilyChild[]

  @@unique([treeId, gedcomXref])
  @@index([partner1Id])
  @@index([partner2Id])
  @@map("families")
}

model FamilyChild {
  id String @id @default(cuid())

  familyId String @map("family_id")
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  individualId String     @map("individual_id")
  individual   Individual @relation(fields: [individualId], references: [id])

  relationType ChildRelationType @default(BIOLOGICAL) @map("relation_type")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([familyId, individualId])
  @@index([individualId])
  @@map("family_children")
}

enum MediaType {
  PHOTO
  DOCUMENT
}

// Photos/documents attached to a person from the info-panel gallery —
// separate from Individual.photoUrl (the single profile picture shown on
// the tree card itself). Files live on disk under uploads/<treeId>/
// <individualId>/; this row just points at the served path.
model PersonMedia {
  id String @id @default(cuid())

  treeId String @map("tree_id")
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)

  individualId String     @map("individual_id")
  individual   Individual @relation(fields: [individualId], references: [id], onDelete: Cascade)

  type     MediaType
  url      String
  filename String
  mimeType String?   @map("mime_type")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([individualId])
  @@index([treeId])
  @@map("person_media")
}
